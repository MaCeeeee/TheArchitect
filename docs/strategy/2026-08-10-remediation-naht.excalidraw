   "type": "text",
   "x": 84,
   "y": 1612,
   "width": 158.95000000000002,
   "height": 21.25,
   "roundness": null,
   "text": "Was das Bild sagt",
   "originalText": "Was das Bild sagt",
   "fontSize": 17,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "angle": 0,
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "seed": 188,
   "version": 1,
   "versionNonce": 1,
   "isDeleted": false,
   "updated": 1,
   "link": null,
   "locked": false,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "boundElements": [],
   "id": "t187",
   "type": "text",
   "x": 84,
   "y": 1644,
   "width": 1451.45,
   "height": 54.375,
   "roundness": null,
   "text": "Die Kette war an DREI Stellen offen, und keine davon lag dort, wo der Fehlertext hinzeigte. Zwei im Datenpfad — das Schema nahm den Korpus-Schlüssel nicht an, und der Join baute\nihn falsch nach —, eine in der Wahrnehmung: die Fläche kannte den Fehler und schwieg. Der Fix ist additiv und trägt sein eigenes Ende: der kanonische Schlüssel wird überall\ngeschrieben, das alte Feld bleibt nur für Bestandsdaten stehen, und beide verschwinden mit dem Index-Flip in P4. Was bis dahin gilt, steht als Kommentar am Feld, nicht nur im Ticket.",
   "originalText": "Die Kette war an DREI Stellen offen, und keine davon lag dort, wo der Fehlertext hinzeigte. Zwei im Datenpfad — das Schema nahm den Korpus-Schlüssel nicht an, und der Join baute\nihn falsch nach —, eine in der Wahrnehmung: die Fläche kannte den Fehler und schwieg. Der Fix ist additiv und trägt sein eigenes Ende: der kanonische Schlüssel wird überall\ngeschrieben, das alte Feld bleibt nur für Bestandsdaten stehen, und beide verschwinden mit dem Index-Flip in P4. Was bis dahin gilt, steht als Kommentar am Feld, nicht nur im Ticket.",
   "fontSize": 14.5,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  }
 ],
