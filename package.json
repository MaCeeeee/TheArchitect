{
  "name": "thearchitect",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.2",
  "description": "TheArchitect - Enterprise Architecture Management Platform with 3D Visualization",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "gate": "npm run gate --workspace=@thearchitect/server",
    "e2e": "playwright test",
    "clean": "turbo run clean",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "nav:graph": "node scripts/nav-graph.mjs",
    "nav:check": "node scripts/nav-graph.mjs --baseline docs/strategy/nav-graph-baseline.json",
    "nav:html": "node scripts/nav-graph.mjs --html",
    "durchstich": "node scripts/gesetz-durchstich.mjs",
    "durchstich:bewertung": "node scripts/bewertung-durchstich.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "turbo": "^2.3.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "pdf-parse": "^1.1.1"
  }
}
