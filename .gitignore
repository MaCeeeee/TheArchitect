# Dependencies
# No trailing slash: also ignores node_modules symlinks (git worktrees create
# these), not just real directories. A trailing slash matches directories only.
node_modules

# Build output
dist/
build/
.turbo/

# Kompilate NEBEN den Quellen. Entstehen, sobald tsc ohne outDir über eine Datei
# läuft (z. B. wenn ein Import über die Paketgrenze greift) — sie landen dann in
# `src/` statt in `dist/` und rutschen unbemerkt in Commits. Beim THE-621-Nachzug
# hätten so acht Artefakte des Crawlers in einem Server-PR gelegen.
# `*.d.ts` ist bewusst NICHT dabei: handgeschriebene Deklarationen sind legitim
# (packages/server/src/types/express.d.ts). Ein tsc-Lauf erzeugt ohnehin immer
# auch .js/.map, damit greifen die Muster unten.
packages/*/src/**/*.js
packages/*/src/**/*.js.map
packages/*/src/**/*.d.ts.map

# Environment
.env
.env.local
.env.*.local

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Testing
coverage/

# TypeScript
*.tsbuildinfo

# Agent skills (installed locally)
.agents/

# Claude Code local settings, plans, skills
.claude/

# Local working files (not for Git)
docs/AUTO_SE_Transformation_CostEnrichment.csv
docs/thearchitect-user-flows.excalidraw

# Predictive-Architecture PoC artifacts (data + venv kept local)
notebooks/predictive-poc/venv/
notebooks/predictive-poc/data/embeddings.npz

# Pitch/demo backup material — large binaries + raw exports, kept local only
docs/pitch-backup/
docs/superpowers/bsh-mirofish-demo-scenarios.pdf

# Superpowers skill scratch (server pids/logs, brainstorm iterations)
.superpowers/

# E2E-Zugangsdaten — NIE einchecken (THE-629)
.env.e2e
e2e-report/
test-results/
